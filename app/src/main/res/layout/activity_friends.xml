<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_bold"
            android:text="Friends"
            android:textColor="@color/ink"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar_placeholder"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="🔍"
            android:textSize="16sp" />

        <FrameLayout
            android:id="@+id/btnChats"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_placeholder"
                android:fontFamily="@font/figtree_regular"
                android:gravity="center"
                android:text="💬"
                android:textSize="16sp" />

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:fontFamily="@font/figtree_bold"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="⌂"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="👥"
            android:textColor="@color/teal"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tabMarketplace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="🏪"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tabNotifications"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="🔔"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tabMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E0D9" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_input_selected"
                    android:fontFamily="@font/figtree_bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="Suggestions"
                    android:textColor="@color/teal"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="@font/figtree_regular"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="Your friends"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_bold"
                    android:text="Friend requests 12"
                    android:textColor="@color/ink"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_bold"
                    android:text="See all"
                    android:textColor="@color/teal"
                    android:textSize="14sp" />
            </LinearLayout>

            <include layout="@layout/item_friend_request_sara" />
            <include layout="@layout/item_friend_request_bilal" />
            <include layout="@layout/item_friend_request_noor" />
            <include layout="@layout/item_friend_request_daniyal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/figtree_bold"
                android:text="People you may know"
                android:textColor="@color/ink"
                android:textSize="17sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>