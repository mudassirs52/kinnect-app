<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_bold"
            android:text="Notifications"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar_placeholder"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="🔍"
            android:textSize="16sp" />

        <FrameLayout
            android:id="@+id/btnChats"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_placeholder"
                android:fontFamily="@font/figtree_regular"
                android:gravity="center"
                android:text="💬"
                android:textSize="16sp" />

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:fontFamily="@font/figtree_bold"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="⌂"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tabFriends"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="👥"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tabMarketplace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="🏪"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="🔔"
            android:textColor="@color/teal"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tabMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E0D9" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:padding="16dp"
                android:text="New"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/teal_light"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_avatar_purple"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:text="AK"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_regular"
                        android:text="Aisha Khan and 32 others reacted to your photo.\n5m"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/teal_light"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_avatar_teal"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:text="SI"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_regular"
                        android:text="Sara Iqbal sent you a friend request.\n20m"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_teal"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Confirm"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Delete"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:padding="16dp"
                android:text="Earlier"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_brown"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="ZR"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_regular"
                    android:text="Zain Raza replied to your comment: &quot;next time invite the rest of us&quot;\n2h"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_purple"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="DC"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_regular"
                    android:text="New post in SMD Class of 2026: &quot;Assignment 1 is out. Start early.&quot;\n5h"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_brown"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="HA"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_regular"
                    android:text="Hamza Ali tagged you in a post.\nYesterday"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_purple"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="LM"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_regular"
                    android:text="Lina Marsh liked your story.\n2d"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/figtree_bold"
                android:gravity="center"
                android:padding="14dp"
                android:text="See previous notifications"
                android:textColor="@color/ink"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>