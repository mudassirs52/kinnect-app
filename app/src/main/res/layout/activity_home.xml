<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_bold"
            android:text="kinnect"
            android:textColor="@color/teal"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar_placeholder"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="🔍"
            android:textSize="16sp" />

        <FrameLayout
            android:id="@+id/btnChats"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_placeholder"
                android:fontFamily="@font/figtree_regular"
                android:gravity="center"
                android:text="💬"
                android:textSize="16sp" />

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:fontFamily="@font/figtree_bold"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="⌂"
            android:textColor="@color/teal"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tabFriends"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="👥"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tabMarketplace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="🏪"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tabNotifications"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="🔔"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tabMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/figtree_regular"
            android:gravity="center"
            android:text="☰"
            android:textColor="@color/ink_muted"
            android:textSize="22sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E0D9" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Create post row -->
            <LinearLayout
                android:id="@+id/btnCreatePost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_avatar_teal"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="center"
                    android:text="JW"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:fontFamily="@font/figtree_regular"
                    android:padding="12dp"
                    android:text="What's on your mind, Jacob?"
                    android:textColor="@color/ink_muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/figtree_regular"
                    android:text="🖼"
                    android:textSize="20sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/bg_warm" />

            <!-- Stories -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/btnCreateStory"
                        android:layout_width="100dp"
                        android:layout_height="150dp"
                        android:layout_marginEnd="8dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_story_light" />

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="24dp"
                            android:background="@drawable/bg_avatar_teal"
                            android:fontFamily="@font/figtree_bold"
                            android:gravity="center"
                            android:text="JW"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="30dp"
                            android:background="@drawable/bg_button_teal"
                            android:fontFamily="@font/figtree_bold"
                            android:gravity="center"
                            android:text="+"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:fontFamily="@font/figtree_bold"
                            android:gravity="center"
                            android:paddingBottom="8dp"
                            android:text="Create story"
                            android:textColor="@color/ink"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnStoryOmar"
                        android:layout_width="100dp"
                        android:layout_height="150dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_story_dark">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="top|start"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_avatar_teal"
                            android:fontFamily="@font/figtree_bold"
                            android:gravity="center"
                            android:text="OF"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:fontFamily="@font/figtree_bold"
                            android:padding="8dp"
                            android:text="Omar Farooq"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="150dp"
                        android:background="@drawable/bg_story_pink">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="top|start"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_avatar_teal"
                            android:fontFamily="@font/figtree_bold"
                            android:gravity="center"
                            android:text="SI"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:fontFamily="@font/figtree_bold"
                            android:padding="8dp"
                            android:text="Sara Iqbal"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                    </FrameLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:background="@color/bg_warm" />

            <!-- Post card -->
            <LinearLayout
                android:id="@+id/postCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_avatar_purple"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:text="LM"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_bold"
                            android:text="Lina Marsh is at Clifton Beach"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_regular"
                            android:text="2h · 🌐"
                            android:textColor="@color/ink_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:text="⋯"
                        android:textColor="@color/ink_muted"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="8dp"
                    android:fontFamily="@font/figtree_regular"
                    android:text="Sunset walk with the crew. Worth every grain of sand in my shoes."
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/postImageGrid"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="2"
                        android:background="@color/rust" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginBottom="2dp"
                            android:layout_weight="1"
                            android:background="@color/teal_light" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#6B5E6E" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/figtree_bold"
                                android:gravity="center"
                                android:text="+4"
                                android:textColor="@color/white"
                                android:textSize="20sp" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_regular"
                        android:text="👍❤️😆 Aisha and 1.2K others"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_regular"
                        android:gravity="end"
                        android:text="86 comments · 12 shares"
                        android:textColor="@color/ink_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E0D9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/btnLike"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="👍 Like"
                        android:textColor="@color/ink_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnComment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="💬 Comment"
                        android:textColor="@color/ink_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="↗ Share"
                        android:textColor="@color/ink_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>